# Frontend (Vite)
# API-Endpunkt für den Adapter-Service
VITE_ADAPTER_ENDPOINT=/api/games
# Optionaler Bearer Token für geschützte Adapter-Endpunkte.
# Achtung: Dieser Wert landet im Frontend-Bundle und darf kein produktiver Secret sein.
VITE_ADAPTER_TOKEN=
# Admin-Oberfläche nur für interne Builds einschalten.
VITE_ENABLE_ADMIN=false
# Optional: öffentliche Links für Footer/Store-Metadaten
VITE_SUPPORT_URL=/support
VITE_PRIVACY_POLICY_URL=/privacy
VITE_SUPPORT_EMAIL=support@scoutx.app

# Timeouts in Millisekunden
VITE_ADAPTER_TIMEOUT_MS=18000
VITE_ROUTE_TIMEOUT_MS=60000
VITE_PDF_ROUTE_REFRESH_TIMEOUT_MS=60000
VITE_PDF_SYNC_TIMEOUT_MS=8000
VITE_GEO_REQUEST_TIMEOUT_MS=12000

# Optional: Cache-Limits (Session-Storage)
VITE_GEO_CACHE_MAX_ENTRIES=500
VITE_ROUTE_CACHE_MAX_ENTRIES=500

# Optional: Google Maps API-Key (kein produktiver Secret im Repo)
VITE_GOOGLE_MAPS_API_KEY=
# Optional: Strict Mode für Google Maps (Default: false)
# true = keine OSRM-/Haversine-Fallbacks für Routen
VITE_GOOGLE_MAPS_STRICT=false

# Adapter-Service
ADAPTER_HOST=0.0.0.0
ADAPTER_PORT=8787
CORS_ORIGIN=*
ADAPTER_TOKEN=scoutx-internal-2026
ADAPTER_MAX_BODY_BYTES=1048576
ADAPTER_MAX_TOKEN_BYTES=4096

# Datenquellen
ADAPTER_DATA_FILE=./adapter-service/data/games.sample.json
ADAPTER_STORE_FILE=./adapter-service/data/games.store.json
ADAPTER_IMPORT_DIR=./adapter-service/imports
ADAPTER_ALIASES_FILE=./adapter-service/data/team-aliases.json
ADAPTER_REMOTE_URL=
ADAPTER_REMOTE_TOKEN=
ADAPTER_REFRESH_INTERVAL_SEC=0

# Automatische Wochen-Aktualisierung
ADAPTER_AUTO_REFRESH_WEEK=true
ADAPTER_WEEK_REFRESH_TTL_SEC=300
ADAPTER_WEEK_SOURCE_URL_TEMPLATE=
ADAPTER_WEEK_SOURCE_TOKEN=
ADAPTER_EXPORT_COMMAND=
ADAPTER_WEEK_COMMAND_TIMEOUT_MS=60000

# Fussball.de Exporter
FUSSBALLDE_BASE_URL=https://www.fussball.de
FUSSBALLDE_MANDANT=22
FUSSBALLDE_REQUEST_TIMEOUT_MS=15000
FUSSBALLDE_PAGE_CONCURRENCY=4
FUSSBALLDE_MATCH_CONCURRENCY=6
FUSSBALLDE_MAX_COMPETITIONS=80
FUSSBALLDE_MAX_MATCHES=600
FUSSBALLDE_SAISON=
FUSSBALLDE_COMPETITION_TYPE=

# Debug
SCOUTX_DEBUG_EXPORTER=false
