{
  "version": 1,
  "travelExpenseButton": "button:has-text('Reisekostenabrechnung')",
  "newTravelExpenseButton": "button:has-text('Neue Reisekostenabrechnung')",
  "purposeInput": "xpath=(//*[normalize-space(.)='Zweck']/following::input[not(@type='hidden') and not(@aria-hidden='true') and not(contains(@class,'tt-hint'))])[1]",
  "noteTextarea": "xpath=(//*[normalize-space(.)='Bemerkung']/following::textarea)[1]",
  "dateRangeInput": "xpath=(//*[normalize-space(.)='Zeitraum']/following::input[not(@type='hidden')])[1]",
  "startTimeInput": "xpath=(//*[normalize-space(.)='Beginn Uhrzeit']/following::input[not(@type='hidden')])[1]",
  "endTimeInput": "xpath=(//*[normalize-space(.)='Ende Uhrzeit']/following::input[not(@type='hidden')])[1]",
  "departureLocationSelect": "xpath=(//*[normalize-space(.)='Abfahrtsort']/following::input[(contains(@class,'tt-input') or @name='departureLocation') and not(@type='hidden') and not(@aria-hidden='true')])[1]",
  "destinationLocationSelect": "xpath=(//*[normalize-space(.)='Zielort']/following::input[(contains(@class,'tt-input') or @name='destinationLocation') and not(@type='hidden') and not(@aria-hidden='true')])[1]",
  "costCenterSelect": "xpath=(//*[normalize-space(.)='Kostenstelle']/following::select)[1]",
  "saveButton": "button:has-text('Speichern')",
  "confirmMissingIntermediateStopsButton": "button:has-text('Ja')",
  "nextToReceiptsButton": "button:has-text('Weiter zu den digitalen Belegen')",
  "kilometersInput": "input[name='kilometers']",
  "newKilometerEntryButton": "xpath=(//a[normalize-space(.)='Neue Kilometerangabe'] | //button[contains(normalize-space(.),'Neue Kilometerangabe') or normalize-space(.)='Neu' or .//span[normalize-space(.)='Neu']])[1]",
  "mileageFromInput": "xpath=(//*[normalize-space(.)='Kilometerangabe']/following::*[normalize-space(.)='Abfahrtsort']/following::input[(contains(@class,'tt-input') or @name='mileageFrom') and not(@type='hidden') and not(@aria-hidden='true')])[1]",
  "mileageToInput": "xpath=(//*[normalize-space(.)='Kilometerangabe']/following::*[normalize-space(.)='Zielort']/following::input[(contains(@class,'tt-input') or @name='mileageTo') and not(@type='hidden') and not(@aria-hidden='true')])[1]",
  "mileageDateInput": "xpath=(//*[normalize-space(.)='Kilometerangabe']/following::*[normalize-space(.)='Datum']/following::input[not(@type='hidden')])[1]",
  "mileageNoteInput": "xpath=(//*[normalize-space(.)='Kilometerangabe']/following::*[normalize-space(.)='Bemerkung']/following::input[not(@type='hidden') and not(@disabled)])[1]",
  "mileageKilometersInput": "xpath=(//*[normalize-space(.)='Kilometerangabe']/following::*[normalize-space(.)='Kilometer']/following::input[not(@type='hidden') and not(@disabled)])[1]",
  "saveKilometerEntryButton": "xpath=(//*[normalize-space(.)='Kilometerangabe']/following::a[normalize-space(.)='Speichern'] | //*[normalize-space(.)='Kilometerangabe']/following::button[contains(normalize-space(.),'Speichern') or contains(normalize-space(.),'speichern')])[1]",
  "saveKilometersButton": "button:has-text('Kilometer speichern')",
  "processRouteButton": "button:has-text('Route abarbeiten')",
  "reportsButton": "button:has-text('Berichte')",
  "completeReportsButton": "button:has-text('Abschließen')",
  "finalCompleteReportsButton": "button:has-text('Final abschließen')",
  "confirmFinalReportSubmitButton": "button:has-text('Ja, abschließen')",
  "routeTextarea": "xpath=(//*[normalize-space(.)='Zwischenorte']/following::input[not(@type='hidden')])[1]",
  "loginUsernameInput": "input[name='username'], input[name='loginName'], input[name='login'], input[type='email'], form input[type='text']",
  "loginPasswordInput": "input[type='password']",
  "loginSubmitButton": "button[type='submit'], input[type='submit'], button:has-text('Anmelden'), button:has-text('Login')",
  "loginMfaHint": "input[name='otp'], input[name='totp'], input[autocomplete='one-time-code'], text=/Zwei-Faktor|Sicherheitscode|Verifizierungscode/i"
}
