    "lint:hrworks": "eslint src/pages/PlanPage.jsx src/pages/PlanPage.test.jsx src/components/HrworksImportReviewModal.jsx src/components/HrworksImportReviewModal.test.jsx src/services/hrworksImport.js src/services/hrworksImport.test.js src/services/hrworksExcelParser.js src/services/hrworksExcelParser.test.js src/services/hrworksCsvExport.js src/services/hrworksCsvExport.test.js src/services/hrworksAutomationClient.js src/services/hrworksAutomationClient.test.js src/services/hrworksSelectorMapping.js src/services/hrworksSelectorMapping.test.js src/services/hrworksPolicy.js src/services/hrworksPolicy.test.js src/services/hrworksAutomationRuntime.js src/services/hrworksAutomationRuntime.test.js src/services/hrworksAuditExport.js src/services/hrworksAuditExport.test.js e2e/helpers/hrworksAutomation.js e2e/helpers/hrworksAutomation.unit.test.js",
    "verify:hrworks": "npm run lint:hrworks && npm run test:hrworks",
    "companion:dev": "node scripts/hrworks-automation-bridge.mjs",
    "hrworks:bridge": "node scripts/hrworks-automation-bridge.mjs",
    "check:hrworks:live-readiness": "./ops/check-hrworks-live-readiness.sh",
    "check:hrworks:evidence-open-items": "./ops/list-hrworks-evidence-open-items.sh",
    "check:hrworks:prompt-checklist": "./ops/check-hrworks-prompt-checklist.sh",
    "check:hrworks:acceptance-status": "./ops/check-hrworks-acceptance-status.sh",
    "update:hrworks:acceptance-from-evidence": "./ops/update-hrworks-acceptance-from-evidence.sh",
    "update:hrworks:live-evidence": "./ops/finalize-hrworks-live-evidence.sh",
    "check:hrworks:go-no-go": "./ops/run-hrworks-go-no-go.sh",
    "check:hrworks:live-closeout": "./ops/run-hrworks-live-closeout.sh",
    "check:hrworks:live-closeout:cmd": "./ops/print-hrworks-live-closeout-command.sh",
    "create:hrworks:live-closeout:cmd-file": "./ops/create-hrworks-live-closeout-command-file.sh",
    "check:hrworks:next-actions": "./ops/print-hrworks-next-actions.sh",
    "prepare:hrworks:final-closeout": "./ops/prepare-hrworks-final-closeout.sh",
    "run:hrworks:final-closeout": "./ops/run-hrworks-final-closeout.sh",
    "run:hrworks:final-closeout:env": "./ops/run-hrworks-final-closeout-from-env.sh",
    "run:hrworks:final-audit": "./ops/run-hrworks-final-audit.sh",
    "report:hrworks:status": "./ops/generate-hrworks-status-report.sh",
    "report:hrworks:handover": "./ops/run-hrworks-handover.sh",
    "test:adapter:db-sot": "NODE_OPTIONS='--localstorage-file=.vitest-localstorage' vitest run adapter-service/server.db-sot.test.mjs",
    "test:adapter:runtime-restart": "NODE_OPTIONS='--localstorage-file=.vitest-localstorage' vitest run adapter-service/server.runtime-restart.test.mjs",
    "test:adapter:runtime-restart-db": "NODE_OPTIONS='--localstorage-file=.vitest-localstorage' vitest run adapter-service/server.runtime-restart.db.test.mjs",
    "test:sandbox": "NODE_OPTIONS='--localstorage-file=.vitest-localstorage' vitest run --exclude adapter-service/server.test.mjs --exclude adapter-service/server.runtime-restart.test.mjs",
    "release:p0:gate": "./ops/check-p0-go-live-gates.sh",
    "release:p1:gate": "./ops/check-p1-go-live-gates.sh",
    "release:p5:gate": "./ops/check-p5-backend-data-gates.sh",
    "release:p6:gate": "./ops/check-p6-privacy-compliance-gates.sh",
    "release:p7:gate": "./ops/check-p7-app-store-metadata-gates.sh",
    "release:p8:gate": "./ops/check-p8-qa-testflight-gates.sh",
    "release:p9:gate": "./ops/check-p9-submission-readiness-gates.sh",
    "release:p9:asc:preflight": "./ops/check-p9-asc-preflight.sh",
    "release:p0:e2e": "./ops/check-p0-e2e-gates.sh",
    "restore:drill:local": "./ops/run-local-restore-drill.sh",
    "soak:sse:smoke": "./ops/sse-soak-smoke.sh",
    "run:hrworks:live-closeout:cmd-file": "./ops/run-hrworks-live-closeout-command-file.sh",
    "update:hrworks:evidence-metadata": "./ops/update-hrworks-evidence-metadata.sh",
    "update:hrworks:prompt-checklist": "./ops/update-hrworks-prompt-checklist-status.sh",
    "update:hrworks:latest-report-refs": "./ops/update-hrworks-latest-report-references.sh",
    "check:hrworks:final-closeout:env-cmd": "./ops/print-hrworks-final-closeout-env-command.sh",
    "check:hrworks:doc-consistency": "./ops/check-hrworks-doc-consistency.sh",
    "check:hrworks:external-closeout-steps": "./ops/print-hrworks-external-closeout-steps.sh"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/share": "^8.0.1",
    "better-sqlite3": "^12.9.0",
    "jspdf": "^4.2.1",
    "pg": "^8.13.1",
