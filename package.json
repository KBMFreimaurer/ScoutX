{
  "name": "scoutx",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "preview": "vite preview",
    "adapter:dev": "node adapter-service/server.mjs",
    "adapter:accounts": "node adapter-service/scripts/team-accounts.mjs",
    "adapter:team-state:backfill": "node adapter-service/scripts/backfill-team-state.mjs --backup",
    "adapter:team-state:check": "node adapter-service/scripts/backfill-team-state.mjs --check",
    "adapter:refresh": "curl -X POST http://127.0.0.1:8787/api/admin/refresh",
    "adapter:clubs:scrape": "node adapter-service/scripts/scrape-clubs.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_OPTIONS='--localstorage-file=.vitest-localstorage' vitest run",
    "test:watch": "NODE_OPTIONS='--localstorage-file=.vitest-localstorage' vitest",
