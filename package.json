    "test:e2e:release": "PLAYWRIGHT_NO_WEBSERVER=true playwright test e2e/release-gates.spec.js",
    "test:e2e:release:db-first": "node -e \"if(!process.env.ADAPTER_DATABASE_URL&&!process.env.DATABASE_URL){console.error('ADAPTER_DATABASE_URL oder DATABASE_URL ist erforderlich.');process.exit(1)}\" && PLAYWRIGHT_NO_WEBSERVER=true playwright test e2e/release-gates.spec.js",
    "test:e2e:release:db-first:local-pg": "./ops/run-db-first-release-e2e-local-pg.sh",
